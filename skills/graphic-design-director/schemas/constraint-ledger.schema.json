{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/graphic-design-director/schemas/constraint-ledger.schema.json",
  "title": "Constraint Ledger",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "HARD",
              "REVIEW"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "content",
              "copy",
              "layout",
              "palette",
              "typography",
              "asset",
              "medium",
              "negative",
              "other"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "enum": [
              "AUTOMATIC",
              "MANUAL",
              "BOTH"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUPERSEDED"
            ]
          }
        },
        "required": [
          "id",
          "level",
          "kind",
          "statement",
          "source",
          "verification",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "approved_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "change_policy": {
            "type": "string",
            "enum": [
              "EXPLICIT_APPROVAL_ONLY",
              "FLEXIBLE"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "source",
          "change_policy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "constraints",
    "approved_decisions"
  ],
  "additionalProperties": false
}
