{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/graphic-design-director/schemas/qa-report.schema.json",
  "title": "Qa Report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "BLOCKED",
        "READY_FOR_CREATIVE",
        "REVIEW_REQUIRED",
        "APPROVED"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "PREFLIGHT",
        "POST_RENDER",
        "FINAL"
      ]
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "REVIEW",
              "SKIPPED"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "WARNING",
              "INFO"
            ]
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "severity",
          "detail",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "status",
    "stage",
    "generated_by",
    "checks",
    "unverified",
    "generated_at"
  ],
  "additionalProperties": false
}
